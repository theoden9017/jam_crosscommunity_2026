[gd_scene format=3]

[ext_resource type="Script" path="res://Menu/pause_menu.gd" id="1_pause"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Panel" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -170.0
offset_right = 180.0
offset_bottom = 170.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Root/Panel"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1

[node name="Title" type="Label" parent="Root/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Pausa"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Root/Panel/VBox"]
custom_minimum_size = Vector2(300, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 21
text = "Riprendi"

[node name="Settings" type="Button" parent="Root/Panel/VBox"]
custom_minimum_size = Vector2(300, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 21
text = "Opzioni"

[node name="MainMenu" type="Button" parent="Root/Panel/VBox"]
custom_minimum_size = Vector2(300, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 21
text = "Menu principale"

[node name="Quit" type="Button" parent="Root/Panel/VBox"]
custom_minimum_size = Vector2(300, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 21
text = "Esci"

[connection signal="pressed" from="Root/Panel/VBox/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Root/Panel/VBox/Settings" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Root/Panel/VBox/MainMenu" to="." method="_on_main_menu_pressed"]
[connection signal="pressed" from="Root/Panel/VBox/Quit" to="." method="_on_quit_pressed"]
